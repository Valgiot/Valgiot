---
// Scène de contact : la fin de l'accueil, et l'ouverture de la page Contact.
// Une seule scène, calme, dans l'esprit de l'ouverture de l'accueil : quelques photos posées en profondeur
// autour d'une phrase, d'un bouton et de l'adresse. Aucune animation de lettres.
// Autonome : son style (src/styles/v2-contact.css) et son comportement (src/scripts/v2/contact.ts) viennent avec elle.
//   Accueil :       <BandeauContact />
//   Page Contact :  <BandeauContact page />
import { Image } from 'astro:assets';
import Bouton from './Bouton.astro';
import { SITE } from '../../site';
import { projets, alea } from '../../lib/v2';
import '../../styles/v2-contact.css';

interface Props {
  /** Sur la page Contact : la phrase devient le titre principal de la page. */
  page?: boolean;
}
const { page = false } = Astro.props;

// Les photos autour de la phrase. Pour chacune : le projet, puis sa place sur grand écran (x et y de 0 à 100 :
// 0 = bord gauche / haut, 100 = bord droit / bas ; l = largeur en % de l'écran ; d = profondeur, plus c'est grand
// plus la photo bouge) et sa place sur téléphone (tx, ty, tl). Sans place téléphone, la photo n'y est pas montrée.
const PLACES = [
  { id: 'sport-padel', x: 5, y: 8, l: 12, d: 1.1, tx: 4, ty: 2, tl: 26 },
  { id: 'evenements-nuit-des-combattants', x: 27, y: 2, l: 8, d: 0.5, tx: 44, ty: 9, tl: 18 },
  { id: 'entreprises-le-club-porticcio', x: 73, y: 4, l: 9, d: 0.7, tx: 96, ty: 0, tl: 22 },
  { id: 'sport-ski', x: 89, y: 14, l: 11, d: 1.3 },
  { id: 'portrait', x: 2, y: 68, l: 9, d: 0.6, tx: 50, ty: 93, tl: 16 },
  { id: 'evenements-french-dart-festival', x: 17, y: 92, l: 10, d: 1.0, tx: 6, ty: 100, tl: 24 },
  { id: 'marques-craft', x: 82, y: 88, l: 12, d: 1.4, tx: 92, ty: 96, tl: 28 },
  { id: 'sport-athletisme', x: 97, y: 64, l: 7, d: 0.5 },
];
const RANG = 3; // on montre la 4ᵉ photo de chaque projet : le début de l'accueil montre déjà les couvertures
const photos = PLACES.flatMap((place) => {
  const p = projets.find((x) => x.id === place.id);
  if (!p) return [];
  const rang = Math.min(RANG, p.photos.length - 1);
  return [{ ...place, p, rang, image: p.photos[rang].image }];
});

const Titre = page ? 'h1' : 'h2';
---

<script is:inline>
  // Les entrées en douceur ne sont préparées que si le visiteur accepte les animations ; sinon tout est affiché d'emblée.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
    document.documentElement.classList.add('ctp-anim');
    // Filet de sécurité : si le script ne se charge pas, rien ne reste caché.
    setTimeout(function () {
      if (document.querySelector('.ctp:not(.est-pret)')) document.documentElement.classList.remove('ctp-anim');
    }, 5000);
  }
</script>

<section class="ctp" id="contact" data-ctp aria-labelledby="ctp-titre">
  {
    photos.map(({ p, rang, image, x, y, l, d, tx, ty, tl }, i) => (
      <a
        class:list={['ctp__photo', { 'ctp__photo--grand': tx === undefined }]}
        href={`/v2/projet/${p.id}/#photo-${rang + 1}`}
        data-ctp-photo
        data-cadre
        data-legende={p.categorie !== p.titre ? `${p.titre} · ${p.categorie}` : p.titre}
        aria-label={`${p.titre}, voir le projet`}
        style={`--x:${x};--y:${y};--l:${l};--d:${d};--tx:${tx ?? 0};--ty:${ty ?? 0};--tl:${tl ?? 0};--ar:${(image.width / image.height).toFixed(3)};--k:${i};--dur:${(7 + 2 * alea(i, 21)).toFixed(1)}s;--del:${(-3 * (alea(i, 22) + 1)).toFixed(1)}s`}
      >
        <Image src={image} alt="" widths={[200, 360, 560]} sizes={`(max-width: 720px) ${tl ?? 20}vw, ${Math.round(l * 1.3)}vw`} quality={78} loading={page ? 'eager' : 'lazy'} draggable="false" />
      </a>
    ))
  }

  <div class="ctp__centre">
    <p class="ctp__repere t-mono">Contact</p>
    <Titre class="ctp__phrase t-ital" id="ctp-titre">Un projet, une idée&#8239;?<br />Écrivez-moi.</Titre>
    <div class="ctp__appel">
      <Bouton texte="Écrire un e-mail" href={`mailto:${SITE.email}?subject=${encodeURIComponent('Demande de projet')}`} plein />
    </div>
    <ul class="ctp__liens">
      <li><a class="lien" href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
      {SITE.telephone && <li><a class="lien" href={`tel:${SITE.telephone.replace(/[^\d+]/g, '')}`}>{SITE.telephone}</a></li>}
      <li>
        <a class="lien" href={SITE.instagram.url} target="_blank" rel="noopener" aria-label={`Instagram : @${SITE.instagram.pseudo} (nouvel onglet)`}>
          @{SITE.instagram.pseudo}
        </a>
      </li>
    </ul>
  </div>
  {page && <p class="ctp__zone t-mono">{SITE.zone}</p>}
</section>

<script>
  import '../../scripts/v2/contact.ts';
</script>
