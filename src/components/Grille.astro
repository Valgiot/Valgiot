---
// Grille centrée de cartes ("nuage") : les lignes incomplètes restent centrées.
interface Props {
  nb: number;
  /** Nombre de colonnes maximum sur grand écran. */
  colonnesMax?: number;
  /** Largeur maximum d'une carte, en pixels. */
  largeurMax?: number;
  label?: string;
}

const { nb, colonnesMax = 4, largeurMax = 300, label } = Astro.props;

// Tout sur une ligne si possible, sinon le nombre de colonnes qui remplit le mieux la dernière ligne.
let colonnes = Math.min(nb, colonnesMax);
if (nb > colonnesMax) {
  let meilleur = -1;
  for (let c = colonnesMax; c >= 3; c--) {
    const reste = nb % c;
    const score = reste === 0 ? c : reste;
    if (score > meilleur) {
      meilleur = score;
      colonnes = c;
    }
  }
}
---

<ul class="grille" style={`--n: ${colonnes}; --largeur-max: ${largeurMax}px`} aria-label={label}>
  <slot />
</ul>

<style>
  .grille {
    --gap: clamp(12px, 2vw, 28px);
    --c: min(var(--n), 2);
    list-style: none;
    margin: 0 auto;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap);
    max-width: calc(var(--c) * var(--largeur-max) + (var(--c) - 1) * var(--gap));
  }
  @media (min-width: 700px) {
    .grille {
      --c: min(var(--n), 3);
    }
  }
  @media (min-width: 1100px) {
    .grille {
      --c: var(--n);
    }
  }
  .grille > :global(li) {
    flex: 0 0 calc((100% - (var(--c) - 1) * var(--gap)) / var(--c));
    min-width: 0;
  }
</style>
