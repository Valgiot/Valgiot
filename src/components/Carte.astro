---
// Une carte cliquable : photo + nom posé dessus. Elle grossit légèrement au survol.
// format "vertical" (rectangles de l'accueil) ou "carre" (sous-parties d'un univers).
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  href: string;
  titre: string;
  sousTitre?: string;
  image?: ImageMetadata;
  format?: 'vertical' | 'carre';
  sizes?: string;
}

const { href, titre, sousTitre, image, format = 'vertical', sizes = '(min-width: 1100px) 25vw, 50vw' } = Astro.props;
---

<a class:list={['carte', `carte--${format}`, { 'carte--vide': !image }]} href={href}>
  {image && <Image src={image} alt="" widths={[320, 480, 720, 1080]} sizes={sizes} class="carte__image" />}
  <span class="carte__texte">
    <span class="carte__titre">{titre}</span>
    {sousTitre && <span class="carte__sous-titre">{sousTitre}</span>}
  </span>
</a>

<style>
  .carte {
    position: relative;
    display: grid;
    place-items: end center;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    color: #fff;
    text-decoration: none;
    /* La taille du texte suit la largeur de la carte (unités cqi). */
    container-type: inline-size;
    box-shadow: 0 6px 20px rgb(6 20 32 / 0.08);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.45s;
  }
  .carte--carre {
    aspect-ratio: 1;
    border-radius: 12px;
  }
  /* Sous-partie sans photo pour l'instant : fond bleu océan. */
  .carte--vide {
    background: radial-gradient(circle at 30% 20%, #1f5f85, var(--ocean) 70%);
  }
  .carte:hover,
  .carte:focus-visible {
    transform: scale(1.04);
    box-shadow: 0 20px 50px rgb(6 20 32 / 0.22);
  }
  .carte__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .carte::after {
    content: '';
    position: absolute;
    inset: 50% 0 0 0;
    background: linear-gradient(to top, rgb(6 20 32 / 0.45), transparent);
  }
  .carte__texte {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 2px;
    max-width: calc(100% - 20px);
    margin-bottom: clamp(10px, 8cqi, 26px);
    padding: 8px 18px;
    border-radius: 8px;
    background: rgb(11 60 93 / 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    text-align: center;
  }
  .carte__titre {
    font-size: clamp(0.95rem, 10cqi, 1.9rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .carte--carre .carte__titre {
    font-size: clamp(0.8rem, 6.5cqi, 1.15rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .carte--carre .carte__texte {
    padding: 7px 14px;
  }
  .carte__sous-titre {
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    opacity: 0.85;
  }
</style>
