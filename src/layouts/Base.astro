---
import '@fontsource-variable/manrope';
import '../styles/global.css';
import { SITE } from '../site';

interface Props {
  titre?: string;
  description?: string;
  image?: string;
  /** En-tête transparent posé sur une grande photo (page d'accueil). */
  transparent?: boolean;
  /** Page encore vide : on demande à Google de ne pas la référencer. */
  noindex?: boolean;
}

const { titre, description = SITE.description, image, transparent = false, noindex = false } = Astro.props;
const titreComplet = titre ? `${titre} — ${SITE.nom}` : `${SITE.accroche}, ${SITE.region} — ${SITE.nom}`;
const canonique = new URL(Astro.url.pathname, Astro.site);
const annee = new Date().getFullYear();

// Fiche d'identité lue par Google (activité, zone, contact, Instagram), sur la page d'accueil.
const accueil = Astro.url.pathname === '/';
const donneesStructurees = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nom,
  description: SITE.description,
  url: Astro.site?.href,
  email: SITE.email,
  image: image ? new URL(image, Astro.site).href : undefined,
  address: {
    '@type': 'PostalAddress',
    addressLocality: SITE.ville,
    addressRegion: SITE.region,
    addressCountry: 'FR',
  },
  areaServed: [
    { '@type': 'City', name: SITE.ville },
    { '@type': 'AdministrativeArea', name: SITE.region },
    { '@type': 'Country', name: 'France' },
  ],
  knowsAbout: SITE.domaines,
  sameAs: [SITE.instagram.url],
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titreComplet}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonique} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#0b3c5d" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titreComplet} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {
      accueil && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(donneesStructurees).replace(/</g, '\\u003c')}
        />
      )
    }
  </head>
  <body>
    <header class:list={["entete", { "entete--transparent": transparent }]}>
      <nav class="conteneur entete__barre" aria-label="Navigation principale">
        <a class="entete__lien" href="/#explorer">Portfolio</a>
        <a class="logo" href="/" aria-label={`${SITE.nom} — accueil`}>{SITE.nom}</a>
        <a class="entete__lien entete__lien--droite" href="/#contact">Contact</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="pied">
      <div class="conteneur pied__barre">
        <p>© {annee} {SITE.nom} — {SITE.accroche}, {SITE.region}</p>
        <p class="pied__liens">
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          <a href={SITE.instagram.url} rel="me noopener" target="_blank">Instagram</a>
          <a href="/mentions-legales">Mentions légales</a>
        </p>
      </div>
    </footer>

    {
      transparent && (
        <script
          is:inline
          set:html={`const e=document.querySelector('.entete');const f=()=>e.classList.toggle('entete--plein',scrollY>innerHeight*0.6);addEventListener('scroll',f,{passive:true});f();`}
        />
      )
    }
  </body>
</html>

<style>
  .entete {
    position: sticky;
    top: 0;
    /* Laisse la place de la barre d'état sur les téléphones à encoche. */
    padding-top: env(safe-area-inset-top, 0px);
    z-index: 10;
    background: color-mix(in srgb, var(--fond) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--bordure);
  }
  .entete--transparent {
    position: fixed;
    inset: 0 0 auto 0;
    background: linear-gradient(to bottom, rgb(6 20 32 / 0.45), transparent);
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
    color: #fff;
    transition: background-color 0.3s, color 0.3s;
  }
  .entete--transparent .entete__lien {
    color: rgb(255 255 255 / 0.85);
  }
  .entete--transparent .entete__lien:hover {
    color: #fff;
  }
  .entete--transparent.entete--plein {
    background: var(--ocean);
    color: #fff;
  }
  .entete__barre {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: 76px;
  }
  .logo {
    font-size: clamp(1.45rem, 4.5vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.22em;
    /* compense l'espace ajouté après la dernière lettre pour un centrage parfait */
    margin-right: -0.22em;
    text-decoration: none;
  }
  .entete__lien {
    justify-self: start;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--texte-doux);
    transition: color 0.2s;
  }
  .entete__lien--droite {
    justify-self: end;
  }
  .entete__lien:hover {
    color: var(--lien);
  }
  @media (max-width: 420px) {
    .entete__lien {
      font-size: 0.7rem;
      letter-spacing: 0.06em;
    }
  }
  .pied {
    border-top: 1px solid var(--bordure);
    padding-block: 28px;
    font-size: 0.85rem;
    color: var(--texte-doux);
  }
  .pied__barre {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    justify-content: space-between;
  }
  .pied p {
    margin: 0;
  }
  .pied__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }
  .pied a {
    text-decoration: none;
  }
  .pied a:hover {
    color: var(--lien);
  }
</style>
