---
// Gabarit du site : en-tête (titre, description et aperçus pour Google et les réseaux), barre, curseur, scripts.
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '@fontsource-variable/instrument-sans';
import '@fontsource-variable/geist-mono';
import '../styles/v2.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Barre from '../components/v2/Barre.astro';
import { SITE } from '../site';
import { projets } from '../lib/v2';

interface Props {
  titre?: string;
  /** Phrase affichée par Google sous le titre de la page. */
  description?: string;
  /** « papier » pour naviguer, « nuit » pour regarder. */
  scene?: 'papier' | 'nuit';
  /** Photo montrée quand on partage le lien (WhatsApp, Instagram, Messenger…). Par défaut : la couverture du premier projet. */
  image?: ImageMetadata;
  /** Page à ne pas montrer dans Google (page d'erreur). */
  noindex?: boolean;
}
const {
  titre = `${SITE.accroche}, ${SITE.region} — ${SITE.nom}`,
  description = SITE.description,
  scene = 'papier',
  image = projets[0]?.couverture,
  noindex = false,
} = Astro.props;
const canonique = new URL(Astro.url.pathname, Astro.site);
const apercu = image ? new URL((await getImage({ src: image, width: 1200, format: 'jpg', quality: 80 })).src, Astro.site) : undefined;

// Fiche d'identité lue par Google (activité, zone, contact, Instagram), sur la page d'accueil.
const accueil = Astro.url.pathname === '/';
const fiche = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: SITE.nom,
  description: SITE.description,
  url: Astro.site?.href,
  email: SITE.email,
  image: apercu?.href,
  address: { '@type': 'PostalAddress', addressLocality: SITE.ville, addressRegion: SITE.region, addressCountry: 'FR' },
  areaServed: [
    { '@type': 'City', name: SITE.ville },
    { '@type': 'AdministrativeArea', name: SITE.region },
    { '@type': 'Country', name: 'France' },
  ],
  knowsAbout: SITE.domaines,
  sameAs: [SITE.instagram.url],
};
---

<!doctype html>
<html lang="fr" data-scene={scene}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titre}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonique} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content={scene === 'nuit' ? '#0b0b0b' : '#efede6'} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={SITE.nom} />
    <meta property="og:title" content={titre} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonique} />
    {apercu && <meta property="og:image" content={apercu} />}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap.xml" />
    {accueil && <script type="application/ld+json" set:html={JSON.stringify(fiche).replace(/</g, '\\u003c')} />}
    <script is:inline>
      // Retour depuis un projet : la page papier renaît du noir (voir « explosion » dans site.ts).
      try {
        if (sessionStorage.getItem('valg-retour')) document.documentElement.classList.add('arrive-du-noir');
        // Entrée dans une collection par son volet : la page s'ouvre sur ce même volet, en grand, puis il laisse place aux projets.
        if (sessionStorage.getItem('valg-porte')) document.documentElement.classList.add('arrive-par-porte');
      } catch (e) {}
      // Les animations d'arrivée attendent que la page soit installée (le script retire cette classe) ; au plus 2,5 s, quoi qu'il arrive.
      document.documentElement.classList.add('attend-page');
      setTimeout(function () { document.documentElement.classList.remove('attend-page'); }, 2500);
    </script>
    <style is:global>
      html.arrive-du-noir .page.scene-papier { clip-path: circle(0px at 50% 50%); }
    </style>
  </head>
  <body>
    <Barre />
    <slot />
    <div class="cadrage" aria-hidden="true"><i></i><i></i><i></i><i></i><span class="cadrage__txt"></span></div>
    <div class="vis" aria-hidden="true"><i></i><i></i><i></i><i></i><b></b></div>
    <span class="onde" aria-hidden="true"></span>
    <script>
      import '../scripts/v2/site.ts';
    </script>
  </body>
</html>
