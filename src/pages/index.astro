---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { categories } from '../lib/photos';
import { SITE } from '../site';

// Diaporama : toutes les photos du dossier src/accueil, dans l'ordre de leur nom.
const diapos = Object.entries(
  import.meta.glob<ImageMetadata>('/src/accueil/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}', {
    eager: true,
    import: 'default',
  }),
)
  .sort(([a], [b]) => a.localeCompare(b, 'fr', { numeric: true }))
  .map(([, image]) => image);

// Logos clients : toutes les images du dossier src/clients. Le nom du fichier sert de nom du client.
const clients = Object.entries(
  import.meta.glob<ImageMetadata>('/src/clients/*.{svg,png,jpg,jpeg,webp,SVG,PNG,JPG,JPEG,WEBP}', {
    eager: true,
    import: 'default',
  }),
)
  .sort(([a], [b]) => a.localeCompare(b, 'fr', { numeric: true }))
  .map(([chemin, image]) => ({
    image,
    nom: chemin
      .split('/')
      .pop()!
      .replace(/\.[^.]+$/, '')
      .replace(/[-_]+/g, ' '),
  }));
---

<Base transparent>
  <section class="hero" aria-label="Présentation">
    <div class="hero__diapos" data-secondes={SITE.diaporamaSecondes}>
      {
        diapos.map((image, i) => (
          <Image
            src={image}
            alt=""
            widths={[800, 1280, 1920, 2400]}
            sizes="100vw"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : 'auto'}
            class:list={['hero__diapo', { 'est-active': i === 0 }]}
          />
        ))
      }
    </div>
    <div class="hero__texte">
      <h1>{SITE.slogan}</h1>
      <p>{SITE.sloganSousTitre}</p>
      <a class="bouton" href="#explorer">{SITE.boutonAccueil}</a>
    </div>
    {
      diapos.length > 1 && (
        <div class="hero__points" aria-hidden="true">
          {diapos.map((_, i) => (
            <span class:list={{ 'est-active': i === 0 }} />
          ))}
        </div>
      )
    }
  </section>

  <div class="contenu">
    <section id="explorer" class="section conteneur" aria-labelledby="titre-explorer">
      <header class="section__entete">
        <h2 id="titre-explorer">Explorez</h2>
        <p>Par univers</p>
      </header>
      <ul class="grille" style={`--nb: ${categories.length}`}>
        {
          categories.map((c) => (
            <li>
              <a class="carte" href={`/${c.slug}/`}>
                {c.couverture ? (
                  <Image
                    src={c.couverture}
                    alt=""
                    widths={[360, 540, 720, 1080]}
                    sizes="(min-width: 1100px) 25vw, 50vw"
                    class="carte__image"
                  />
                ) : (
                  <span class="carte__image" />
                )}
                <span class="carte__titre">{c.titre}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {
      clients.length > 0 && (
        <section class="section section--clients" aria-labelledby="titre-clients">
          <div class="conteneur">
            <header class="section__entete">
              <h2 id="titre-clients">Ils m'ont fait confiance</h2>
            </header>
            <ul class="logos">
              {clients.map((c) => (
                <li>
                  <Image src={c.image} alt={c.nom} width={240} class="logo-client" />
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <section id="contact" class="contact" aria-labelledby="titre-contact">
      <div class="conteneur contact__contenu">
        <header class="section__entete">
          <h2 id="titre-contact">Un projet ? Parlons-en.</h2>
          <p>Basé à {SITE.ville}. {SITE.zone}</p>
        </header>
        <div class="contact__actions">
          <a class="bouton bouton--plein" href={`mailto:${SITE.email}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18v12H3z M3 6l9 7 9-7"></path></svg>
            {SITE.email}
          </a>
          <a class="bouton bouton--contour" href={SITE.instagram.url} target="_blank" rel="me noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"></circle>
            </svg>
            Suivre @{SITE.instagram.pseudo}
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<script>
  const conteneur = document.querySelector<HTMLElement>('.hero__diapos');
  const diapos = [...document.querySelectorAll<HTMLElement>('.hero__diapo')];
  const points = [...document.querySelectorAll<HTMLElement>('.hero__points span')];
  const calme = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (conteneur && diapos.length > 1 && !calme) {
    let courante = 0;
    setInterval(
      () => {
        if (document.hidden) return;
        diapos[courante].classList.remove('est-active');
        points[courante]?.classList.remove('est-active');
        courante = (courante + 1) % diapos.length;
        diapos[courante].classList.add('est-active');
        points[courante]?.classList.add('est-active');
      },
      Number(conteneur.dataset.secondes || 8) * 1000,
    );
  }
</script>

<style>
  /* --- Diaporama plein écran : il reste en place, la page glisse par-dessus. --- */
  .hero {
    position: sticky;
    top: 0;
    z-index: 0;
    height: 100svh;
    min-height: 480px;
    overflow: hidden;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--ocean);
  }
  .hero__diapos {
    position: absolute;
    inset: 0;
  }
  .hero__diapos::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(6 20 32 / 0.35), rgb(6 20 32 / 0.15) 70%);
  }
  .hero__diapo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.06);
    transition:
      opacity 1.6s ease,
      transform 10s linear;
  }
  .hero__diapo.est-active {
    opacity: 1;
    transform: scale(1);
  }
  .hero__texte {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 18px;
    padding-inline: var(--marge);
    text-align: center;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
  }
  .hero h1 {
    font-size: clamp(2.4rem, 7vw, 5.2rem);
    font-weight: 400;
    letter-spacing: -0.02em;
  }
  .hero p {
    margin: 0;
    font-size: clamp(0.85rem, 1.6vw, 1.05rem);
    letter-spacing: 0.12em;
  }
  .hero__points {
    position: absolute;
    bottom: 28px;
    display: flex;
    gap: 8px;
  }
  .hero__points span {
    width: 24px;
    height: 2px;
    background: rgb(255 255 255 / 0.4);
    transition: background-color 0.6s;
  }
  .hero__points span.est-active {
    background: #fff;
  }

  .bouton {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 18px;
    padding: 16px 32px;
    border-radius: 999px;
    background: #fff;
    color: var(--texte);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none;
    text-shadow: none;
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.18);
    transition:
      transform 0.25s,
      box-shadow 0.25s,
      background-color 0.25s,
      color 0.25s;
  }
  .bouton:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.25);
  }

  /* --- Contenu qui recouvre le diaporama --- */
  .contenu {
    position: relative;
    z-index: 1;
    background: var(--fond);
  }
  .section {
    padding-block: clamp(64px, 10vw, 128px);
  }
  .section__entete {
    text-align: center;
    margin-bottom: clamp(32px, 5vw, 56px);
  }
  .section__entete h2 {
    font-size: clamp(2rem, 5vw, 3.4rem);
    font-weight: 400;
  }
  .section__entete p {
    margin: 10px 0 0;
    color: var(--texte-doux);
    font-size: clamp(1rem, 1.8vw, 1.25rem);
  }

  /* --- Explorez : rectangles verticaux --- */
  .grille {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(12px, 2vw, 28px);
    grid-template-columns: repeat(2, 1fr);
  }
  @media (min-width: 1100px) {
    .grille {
      grid-template-columns: repeat(min(var(--nb), 4), 1fr);
    }
  }
  .carte {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 14px;
    background: var(--surface);
    color: #fff;
    text-decoration: none;
    box-shadow: 0 6px 20px rgb(6 20 32 / 0.08);
    transition:
      transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
      box-shadow 0.45s;
  }
  .carte:hover,
  .carte:focus-visible {
    transform: scale(1.04);
    box-shadow: 0 20px 50px rgb(6 20 32 / 0.22);
  }
  .carte__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .carte__titre {
    position: relative;
    padding: 8px 18px;
    border-radius: 8px;
    background: rgb(11 60 93 / 0.45);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
    font-size: clamp(1.05rem, 3.4vw, 1.9rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }

  /* --- Clients --- */
  .section--clients {
    background: var(--surface);
  }
  .logos {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: clamp(24px, 4vw, 48px) clamp(16px, 3vw, 40px);
    align-items: center;
    justify-items: center;
  }
  .logo-client {
    width: 100%;
    max-width: 180px;
    max-height: 80px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.7;
    transition:
      filter 0.3s,
      opacity 0.3s;
  }
  .logo-client:hover {
    filter: none;
    opacity: 1;
  }

  /* --- Contact --- */
  .contact {
    background: var(--ocean);
    color: #eef3f7;
  }
  .contact__contenu {
    padding-block: clamp(64px, 10vw, 120px);
    display: grid;
    justify-items: center;
  }
  .contact .section__entete {
    margin-bottom: 8px;
  }
  .contact .section__entete p {
    color: rgb(238 243 247 / 0.75);
  }
  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0 16px;
  }
  .contact__actions .bouton {
    letter-spacing: 0.04em;
    text-transform: none;
    font-size: 0.95rem;
    overflow-wrap: anywhere;
  }
  .bouton--contour {
    background: transparent;
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.7);
  }
  .bouton--contour:hover {
    background: #fff;
    color: var(--ocean);
  }
  .bouton svg {
    flex: none;
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linejoin: round;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero {
      position: relative;
    }
  }
</style>

<style is:global>
  body:has(#contact) .pied {
    position: relative;
    z-index: 1;
    border-top: 0;
    background: var(--fond);
  }
</style>
