---
// Mentions légales de la refonte : mêmes textes que l'ancienne page, dans le nouveau gabarit.
// Les informations de l'éditeur se remplissent dans src/site.ts (« mentions ») : une ligne vide n'apparaît pas.
import V2 from '../../layouts/V2.astro';
import Pied from '../../components/v2/Pied.astro';
import { SITE } from '../../site';

const m = SITE.mentions;
---

<V2 titre={`Mentions légales — ${SITE.nom}`} description={`Mentions légales et confidentialité du site ${SITE.nom}.`}>
  <main class="page scene-papier" data-page="mentions">
    <article class="ml">
      <p class="t-mono">Informations</p>
      <h1 class="ml__titre t-ital">Mentions légales</h1>

      <div class="ml__bloc">
        <h2 class="t-mono">Éditeur du site</h2>
        <p>
          {SITE.nom}{m.responsable && ` — ${m.responsable}`}{m.statut && `, ${m.statut}`}<br />
          {m.siret && <>SIRET : {m.siret}<br /></>}
          {m.adresse ? <>Adresse : {m.adresse}<br /></> : <>Basé à {SITE.ville}<br /></>}
          Contact : <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          {SITE.telephone && <><br />Téléphone : {SITE.telephone}</>}
        </p>
      </div>

      <div class="ml__bloc">
        <h2 class="t-mono">Hébergement</h2>
        <p>{SITE.hebergeur}</p>
      </div>

      <div class="ml__bloc">
        <h2 class="t-mono">Propriété intellectuelle</h2>
        <p>
          Toutes les photographies et vidéos présentes sur ce site sont la propriété exclusive de {SITE.nom}, sauf mention contraire. Toute
          reproduction, diffusion ou utilisation sans autorisation écrite préalable est interdite.
        </p>
      </div>

      <div class="ml__bloc">
        <h2 class="t-mono">Données personnelles</h2>
        <p>
          Ce site ne dépose aucun cookie publicitaire ni de suivi. Les informations que vous envoyez par e-mail sont utilisées uniquement pour
          répondre à votre demande et ne sont jamais transmises à des tiers. Vous pouvez demander leur suppression à tout moment à{' '}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
        </p>
      </div>

      <div class="ml__bloc">
        <h2 class="t-mono">Droit à l'image</h2>
        <p>
          Si vous apparaissez sur une photo et souhaitez qu'elle soit retirée, écrivez à{' '}
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a> : elle sera retirée dans les meilleurs délais.
        </p>
      </div>
    </article>

    <Pied />
  </main>
</V2>

<style>
  .ml {
    padding: clamp(120px, 15vw, 200px) var(--marge) clamp(80px, 10vw, 150px);
  }
  .ml > .t-mono {
    color: var(--doux);
  }
  .ml__titre {
    margin: 14px 0 clamp(40px, 6vw, 84px);
    font-size: clamp(2.2rem, 5vw, 4.6rem);
    line-height: 1;
  }
  .ml__bloc {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.4fr);
    gap: 10px clamp(20px, 5vw, 80px);
    align-items: baseline;
    padding: 22px 0;
    border-top: 1px solid var(--trait);
  }
  .ml__bloc h2 {
    margin: 0;
    font-weight: 400;
    color: var(--doux);
  }
  .ml__bloc p {
    max-width: 62ch;
    line-height: 1.6;
  }
  .ml__bloc a {
    text-underline-offset: 3px;
  }
  @media (max-width: 720px) {
    .ml__bloc {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
