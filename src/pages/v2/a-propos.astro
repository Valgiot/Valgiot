---
// À propos : un récit au défilement, en sept temps.
//   Ouverture (papier)  ·  1. Le terrain (la photo s'ouvre, le papier devient nuit)  ·  2. L'instant (rafale, obturateur)
//   3. Le silence (papier, détails)  ·  4. La lumière (le papier implose, la lumière ouvre les photos)
//   5. Le bruit (nuit, le titre vibre)  ·  6. Ailleurs (papier)  ·  7. Moi (emplacement du portrait)  ·  Ouverture vers le contact
// Les textes sont des propositions : ils ne s'appuient que sur ce qui est écrit dans src/site.ts et dans les fichiers
// categorie.json. Les passages à remplacer par l'histoire vraie de Valentin sont marqués « À VALIDER ».
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import V2 from '../../layouts/V2.astro';
import Pied from '../../components/v2/Pied.astro';
import Bouton from '../../components/v2/Bouton.astro';
import Compteur from '../../components/v2/Compteur.astro';
import { SITE } from '../../site';
import { projets, univers, totalPhotos, deuxChiffres } from '../../lib/v2';
import '../../styles/v2-apropos.css';

// Le portrait de Valentin : les photos déposées dans src/portrait/ (celle dont le nom contient « a-propos », sinon la première).
const portraits = import.meta.glob<{ default: ImageMetadata }>('/src/portrait/*.{jpg,jpeg,png,webp,JPG,JPEG,PNG,WEBP}', { eager: true });
const clesPortrait = Object.keys(portraits).sort();
const portrait = portraits[clesPortrait.find((k) => k.includes('a-propos')) ?? clesPortrait[0]]?.default;

// Une photo précise : projet + début du nom du fichier. Si elle est retirée du site, la couverture du projet la remplace.
const vue = (id: string, debut: string) => {
  const p = projets.find((x) => x.id === id) ?? projets[0];
  const ph = p.id === id ? p.photos.find((x) => x.nom.startsWith(debut)) : undefined;
  const rang = ph ? p.photos.indexOf(ph) + 1 : 1;
  return {
    p,
    image: ph?.image ?? p.couverture,
    rang,
    href: `/v2/projet/${p.id}/#photo-${rang}`,
    legende: `${p.titre} · ${deuxChiffres(rang)} / ${p.photos.length}`,
  };
};

// 1. Le terrain
const terrain = vue('sport-football', '08-');
// 2. L'instant : chaque image a son mot.
const instants = [
  { article: 'un', mot: 'cri.', ...vue('sport-padel', '01-') },
  { article: 'une', mot: 'chute.', ...vue('sport-padel', '06-') },
  { article: 'un', mot: 'doute.', ...vue('sport-football', '17-') },
  { article: 'la', mot: 'joie.', ...vue('evenements-french-dart-festival', '10-') },
  { article: 'une', mot: 'étreinte.', ...vue('sport-football', '27-') },
];
// 3. Le silence : trois détails. « derive » = amplitude du glissement au défilement.
const details = [
  { derive: 70, ...vue('sport-football', '22-') },
  { derive: 120, ...vue('evenements-french-dart-festival', '03-') },
  { derive: 90, ...vue('evenements-french-dart-festival', '14-') },
];
// 4. La lumière : ox / oy = l'endroit de la photo d'où vient la lumière (en % du cadre), c'est de là qu'elle s'ouvre.
const lumieres = [
  { source: "Celle d'un projecteur.", ox: 62, oy: 20, ...vue('sport-padel', '03-') },
  { source: "Celle d'un fumigène.", ox: 86, oy: 40, ...vue('evenements-30-ans-mnk', '01-') },
  { source: "Celle d'un soleil qui tombe.", ox: 58, oy: 9, ...vue('entreprises-le-club-porticcio', '06-') },
];
// 5. Le bruit
const bruits = [vue('evenements-30-ans-mnk', '04-'), vue('sport-football', '14-'), vue('evenements-french-dart-festival', '09-')];
// 6. Ailleurs : une photo par collection, hors sport.
const ailleurs = [
  { derive: 60, ...vue('entreprises-le-club-porticcio', '02-') },
  { derive: 110, ...vue('marques-craft', '04-') },
  { derive: 40, ...vue('portrait', '08-') },
  { derive: 90, ...vue('evenements-french-dart-festival', '17-') },
];
// Espace insécable avant les deux-points et les points d'interrogation : la ponctuation ne passe jamais seule à la ligne.
const insecable = (t: string) => t.replace(/ ([:;?!])/g, '\u00a0$1');
const sujets = univers.map((u) => u.titre).join(' · ');
const metier = SITE.accroche.charAt(0).toLowerCase() + SITE.accroche.slice(1);
---

<V2
  titre={`À propos — ${SITE.nom}, ${metier}`}
  description={`${SITE.nom}, ${metier} : le terrain, l'instant, la lumière. ${SITE.zone}`}
  scene="papier"
>
  <main class="page scene-papier ap" data-page="a-propos">
    <script is:inline>
      // Les scènes épinglées ne s'activent que si le visiteur accepte les animations : sinon la page reste simple et lisible.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('ap-anime');
    </script>

    <!-- Ouverture -->
    <section class="ap-ouv" data-ap-ton="papier" aria-labelledby="ap-titre">
      <div class="ap-ouv__haut t-mono">
        <span>À propos</span>
        <span>{SITE.ville}, {SITE.region}</span>
      </div>
      <div class="ap-ouv__bloc">
        <h1 class="ap-ouv__titre t-titre" id="ap-titre" data-entree>Je photographie<br />ce qui ne se<br /><span class="t-ital">rejoue pas.</span></h1>
        <div class="ap-ouv__sous">
          <!-- À VALIDER : le nom affiché (Valentin Giot ? V.A.L.G ?) -->
          <p class="t-ital">Valentin Giot — photographe &amp; vidéaste à Caen.</p>
        </div>
      </div>
    </section>

    <!-- 1. Le terrain : une fenêtre sur le match, qui s'ouvre jusqu'à remplir l'écran. -->
    <section class="ap-terrain" id="le-terrain" data-ap-terrain data-ap-ton="papier" aria-labelledby="ap-t1">
      <div class="ap-terrain__fixe" data-ap-fixe>
        <div class="ap-terrain__txt">
          <span class="ap-chap t-mono">01 — Le terrain</span>
          <h2 class="ap-terrain__titre t-titre" id="ap-t1">Ma place<br />est <span class="t-ital">au bord</span><br />du terrain.</h2>
        </div>
        <div class="ap-terrain__photo">
          <Image src={terrain.image} alt="Un match de football vu de derrière le filet du but" widths={[800, 1400, 2000]} sizes="100vw" quality={80} loading="eager" draggable="false" />
          <!-- Le même texte, en clair, découpé par la fenêtre : il est sombre sur le papier et clair sur la photo, au pixel près. -->
          <div class="ap-terrain__txt ap-terrain__txt--clair" aria-hidden="true">
            <span class="ap-chap t-mono">01 — Le terrain</span>
            <p class="ap-terrain__titre t-titre">Ma place<br />est <span class="t-ital">au bord</span><br />du terrain.</p>
          </div>
        </div>
        <p class="ap-terrain__suite">Derrière le filet, le long de la ligne, à hauteur de pelouse. Assez près pour entendre les crampons.</p>
      </div>
    </section>

    <!-- 2. L'instant : cinq images, cinq coups d'obturateur. -->
    <section class="ap-instant scene-nuit" id="l-instant" data-ap-instant data-ap-ton="nuit" aria-labelledby="ap-t2">
      <div class="ap-instant__fixe" data-ap-fixe>
        <span class="ap-chap ap-instant__chap t-mono">02 — L'instant</span>
        <div class="ap-instant__cote">
          <span class="t-mono" data-ap-ou>{instants[0].p.titre}</span>
          <Compteur valeur={1} total={instants.length} data-ap-rang />
        </div>
        <div class="ap-instant__cadre" data-ap-cadre>
          {
            instants.map((v, i) => (
              <a class:list={['ap-instant__vue', { 'est-la': i === 0 }]} href={v.href} data-ap-vue data-vers-projet data-cadre data-nom={v.p.titre} data-legende={v.legende} aria-label={`${v.p.titre}, photo ${v.rang} sur ${v.p.photos.length}`}>
                <Image src={v.image} alt="" widths={[480, 800, 1200]} sizes="(max-width: 720px) 78vw, 54vh" quality={82} draggable="false" />
              </a>
            ))
          }
          <i class="ap-lame ap-lame--haut" data-ap-lame aria-hidden="true"></i>
          <i class="ap-lame ap-lame--bas" data-ap-lame aria-hidden="true"></i>
        </div>
        <h2 class="ap-instant__mots" id="ap-t2">
          {
            instants.map((v, i) => (
              <span class:list={['ap-instant__mot', { 'est-la': i === 0 }]} data-ap-mot>
                <i class="t-ital">{v.article}</i>{' '}
                <b class="t-titre"><span>{v.mot}</span></b>{' '}
              </span>
            ))
          }
        </h2>
        <p class="ap-instant__chute" data-ap-chute>Ça dure une seconde.<br />Il n'y a pas de deuxième prise.</p>
        <div class="ap-instant__papier" data-ap-papier aria-hidden="true"></div>
      </div>
    </section>

    <!-- 3. Le silence : presque rien sur la page. -->
    <section class="ap-silence" id="le-silence" data-ap-ton="papier" aria-labelledby="ap-t3">
      <span class="ap-chap t-mono">03 — Le silence</span>
      <h2 class="ap-silence__txt" id="ap-t3" data-lit>Et puis il y a ce qui ne fait pas de bruit.</h2>
      <p class="ap-silence__txt ap-silence__txt--2" data-lit>Des mains. Des crampons. Une fléchette entre deux doigts.</p>
      <div class="ap-silence__photos">
        {
          details.map((v) => (
            <a class="ap-silence__photo" href={v.href} data-vers-projet data-cadre data-legende={v.legende} data-ap-derive={v.derive} aria-label={`${v.p.titre}, photo ${v.rang} sur ${v.p.photos.length}`}>
              <Image src={v.image} alt="" widths={[240, 420, 640]} sizes="(max-width: 720px) 30vw, 16vw" quality={80} draggable="false" />
            </a>
          ))
        }
      </div>
    </section>

    <!-- 4. La lumière : le papier se referme sur un point, et c'est de ce point que la lumière revient. -->
    <section class="ap-lumiere scene-nuit" id="la-lumiere" data-ap-lumiere data-ap-ton="papier" aria-labelledby="ap-t4">
      <div class="ap-lumiere__fixe" data-ap-fixe>
        <div class="ap-lumiere__papier" data-ap-papier>
          <p>Il manque encore une chose.</p>
        </div>
        <div class="ap-lumiere__txt" data-ap-txt>
          <span class="ap-chap t-mono">04 — La lumière</span>
          <h2 class="ap-lumiere__titre t-titre" id="ap-t4">La <span class="t-ital">lumière.</span></h2>
          <p class="ap-lumiere__sources">
            {lumieres.map((v) => <span data-ap-source>{v.source} </span>)}
          </p>
        </div>
        <div class="ap-lumiere__cadre" data-ap-cadre>
          {
            lumieres.map((v) => (
              <a class="ap-lumiere__vue" href={v.href} style={`--ox:${v.ox}%;--oy:${v.oy}%`} data-ox={v.ox} data-oy={v.oy} data-ap-vue data-vers-projet data-cadre data-legende={v.legende} aria-label={`${v.p.titre}, photo ${v.rang} sur ${v.p.photos.length}`}>
                <Image src={v.image} alt="" widths={[480, 800, 1200]} sizes="(max-width: 720px) 80vw, 46vw" quality={82} draggable="false" />
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- 5. Le bruit : le titre vibre comme une salle. -->
    <section class="ap-son scene-nuit" id="le-bruit" data-ap-ton="nuit" aria-labelledby="ap-t5">
      <span class="ap-chap t-mono">05 — Le bruit</span>
      <h2 class="ap-son__titre t-titre" id="ap-t5"><span class="t-ital">Une salle,</span><br /><span class="ap-egal" data-ap-egal>ça s'entend.</span></h2>
      <div class="ap-son__trio">
        <a class="ap-son__photo ap-son__photo--1" href={bruits[0].href} data-vers-projet data-cadre data-legende={bruits[0].legende} data-ap-leve aria-label={bruits[0].legende}>
          <Image src={bruits[0].image} alt="Un supporter crie, les bras ouverts" widths={[480, 800, 1200]} sizes="(max-width: 720px) 92vw, 38vw" quality={82} draggable="false" />
        </a>
        <div class="ap-son__milieu">
          <a class="ap-son__photo" href={bruits[1].href} data-vers-projet data-cadre data-legende={bruits[1].legende} data-ap-leve aria-label={bruits[1].legende}>
            <Image src={bruits[1].image} alt="Une tribune de supporters, un drapeau levé" widths={[480, 800, 1200]} sizes="(max-width: 720px) 92vw, 32vw" quality={82} draggable="false" />
          </a>
          <p class="ap-son__texte" data-lit>Les chants, les pancartes, le souffle avant le coup de gong. J'essaie que tout ça reste dans l'image.</p>
        </div>
        <a class="ap-son__photo ap-son__photo--3" href={bruits[2].href} data-vers-projet data-cadre data-legende={bruits[2].legende} data-ap-leve aria-label={bruits[2].legende}>
          <Image src={bruits[2].image} alt="Le public lève ses pancartes" widths={[360, 640, 960]} sizes="(max-width: 720px) 60vw, 24vw" quality={82} draggable="false" />
        </a>
      </div>
    </section>

    <!-- 6. Ailleurs : le même regard, hors des stades. -->
    <section class="ap-ailleurs" id="ailleurs" data-ap-ton="papier" aria-labelledby="ap-t6">
      <div class="ap-ailleurs__tete">
        <span class="ap-chap t-mono">06 — Ailleurs</span>
        <h2 class="ap-ailleurs__titre t-titre" id="ap-t6" data-revele>Je regarde une assiette <span class="t-ital">comme</span> je regarde un match.</h2>
        <p class="ap-ailleurs__texte" data-lit>Sur un terrain, dans une cuisine, dans une soirée&nbsp;: je fais la même chose. Je me fais oublier, et j'attends que ça arrive.</p>
      </div>
      <div class="ap-ailleurs__tirages">
        {
          ailleurs.map((v) => (
            <a class="ap-tirage" href={v.href} data-vers-projet data-ap-derive={v.derive} aria-label={`${v.p.categorie}, ${v.p.titre}`}>
              <span class="ap-tirage__img" data-cadre data-legende={`Ouvrir ${v.p.titre}`} data-ap-leve>
                <Image src={v.image} alt="" widths={[360, 640, 960]} sizes="(max-width: 720px) 46vw, 24vw" quality={80} draggable="false" />
              </span>
              <span class="ap-tirage__nom t-mono">
                <span>{v.p.categorie}</span>
                {v.p.titre !== v.p.categorie && <span>{v.p.titre}</span>}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- 7. Moi -->
    <section class="ap-moi" id="moi" data-ap-ton="papier" aria-labelledby="ap-t7">
      <!-- Le portrait de Valentin (dossier src/portrait/). Sans photo, un cadre de viseur vide annonce qu'elle viendra. -->
      {
        portrait ? (
          <div class="ap-moi__portrait ap-moi__portrait--photo">
            <Image src={portrait} alt="Valentin Giot, appareil photo en main, sur le port" widths={[480, 800, 1040]} sizes="(max-width: 720px) 88vw, 36vw" quality={82} />
          </div>
        ) : (
          <div class="ap-moi__portrait" data-emplacement="portrait-de-valentin" role="img" aria-label="Emplacement réservé au portrait de Valentin : photo à venir">
            <i></i><i></i><i></i><i></i>
            <span class="ap-moi__croix" aria-hidden="true"></span>
            <span class="ap-moi__note" aria-hidden="true">
              <span class="t-mono">Portrait à venir</span>
              <span class="t-ital">Ici, la photo de Valentin.</span>
            </span>
          </div>
        )
      }
      <div class="ap-moi__txt">
        <span class="ap-chap t-mono">07 — Moi</span>
        <h2 class="ap-moi__titre t-titre" id="ap-t7" data-revele>Moi, c'est <span class="t-ital">Valentin.</span></h2>
        <!-- Texte repris tel quel de src/site.ts (présentation et zone), écrit par Valentin. -->
        <p class="ap-moi__texte">{insecable(SITE.presentation)}</p>
        <p class="ap-moi__texte ap-moi__texte--doux">{SITE.zone}</p>
        <dl class="ap-fiche t-mono">
          <div><dt>Base</dt><dd>{SITE.ville}, {SITE.region}</dd></div>
          <div><dt>Images</dt><dd>Photo &amp; vidéo</dd></div>
          <div><dt>Sujets</dt><dd>{sujets}</dd></div>
          <div><dt>Sur le site</dt><dd>{projets.length} projets · {totalPhotos} photos</dd></div>
        </dl>
      </div>
    </section>

    <!-- Ouverture vers le contact et les collections -->
    <section class="ap-fin" data-ap-ton="papier" aria-labelledby="ap-t8">
      <span class="t-mono ap-chap">Et maintenant</span>
      <h2 class="ap-fin__mot t-titre" id="ap-t8" data-revele>Le prochain instant,<br /><span class="t-ital">c'est le vôtre&nbsp;?</span></h2>
      <p class="ap-fin__texte">Un match, une soirée, une table, une marque&nbsp;: dites-moi ce que vous préparez.</p>
      <div class="rangee">
        <Bouton texte="Me contacter" href="/v2/contact/" plein />
        <Bouton texte="Voir les collections" href="/v2/collection/" />
      </div>
    </section>

    <Pied data-ap-ton="papier" />

  </main>
  <script>
    import '../../scripts/v2/apropos.ts';
  </script>
</V2>
