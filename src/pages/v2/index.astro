---
// Accueil de la refonte : un récit au défilement.
// 1. Le ciel (le nom et les photos en profondeur)  2. Le manifeste  (3. le paquet de projets vedettes a été retiré)
// 4. Le passage (toutes les photos nous frôlent)  5. L'anneau de tous les projets  6. Les références  7. Le contact
import { Image } from 'astro:assets';
import V2 from '../../layouts/V2.astro';
import Pied from '../../components/v2/Pied.astro';
import Anneau from '../../components/v2/Anneau.astro';
import Bouton from '../../components/v2/Bouton.astro';
import Compteur from '../../components/v2/Compteur.astro';
import Vue from '../../components/v2/Vue.astro';
import Presentation from '../../components/v2/Presentation.astro';
import BandeauContact from '../../components/v2/BandeauContact.astro';
import { SITE } from '../../site';
import { totalPhotos, projets, alea, deuxChiffres } from '../../lib/v2';

// Acte 1 — place de chaque photo : x et y en % de l'écran, largeur en vw, profondeur (plus c'est grand, plus ça bouge).
const CIEL = [
  { x: 4, y: 11, w: 13, d: 1.2, z: 1 },
  { x: 25, y: 5, w: 8, d: 0.5, z: 1 },
  { x: 45, y: 8, w: 10, d: 0.8, z: 3 },
  { x: 66, y: 4, w: 8, d: 0.4, z: 1 },
  { x: 82, y: 13, w: 12, d: 1.3, z: 3 },
  { x: 1, y: 54, w: 9, d: 0.7, z: 1 },
  { x: 89, y: 52, w: 8, d: 0.6, z: 1 },
  { x: 13, y: 73, w: 11, d: 1.0, z: 3 },
  { x: 32, y: 80, w: 8, d: 0.5, z: 1 },
  { x: 52, y: 74, w: 12, d: 1.4, z: 3 },
  { x: 73, y: 80, w: 9, d: 0.8, z: 1 },
];
const ciel = projets.slice(0, CIEL.length).map((p, i) => ({ p, ...CIEL[i] }));

// Films — les deux premiers films de Valentin, convertis pour le web dans public/v2/films/ (fichier .mp4 + image d'attente .jpg).
// Le premier est en largeur : il s'ouvre en plein écran. Le second est en hauteur : il vient se poser au centre.
const FILMS = [
  { titre: 'Padel', src: '/v2/films/padel.mp4', affiche: '/v2/films/padel.jpg' },
  { titre: 'Cyclisme', src: '/v2/films/cyclisme.mp4', affiche: '/v2/films/cyclisme.jpg' },
];

// Acte 4 — 30 photos, en piochant à tour de rôle dans chaque projet pour que deux voisines ne se ressemblent pas.
const grains = [1, 2, 3].flatMap((rang) => projets.flatMap((p) => (p.photos[rang] ? [{ photo: p.photos[rang], p, rang }] : []))).slice(0, 30);
---

<V2 scene="papier">
  <main class="page scene-papier" data-page="accueil">
    <!-- Acte 1 -->
    <section class="ciel" data-ciel aria-label="Présentation">
      {
        ciel.map(({ p, x, y, w, d, z }, i) => (
          <a
            class="ciel__photo"
            href={`/v2/projet/${p.id}/`}
            data-vers-projet
            data-cadre
            data-legende={`${p.titre} · ${p.photos.length} photos`}
            aria-label={`${p.titre}, ${p.photos.length} photos`}
            style={`--x:${x};--y:${y};--w:${w};--d:${d};--z:${z};--dur:${(7 + 2 * alea(i, 9)).toFixed(1)}s;--del:${(-3 * (alea(i, 10) + 1)).toFixed(1)}s`}
          >
            <Image src={p.couverture} alt="" widths={[200, 360, 560]} sizes={`${Math.round(w * 1.4)}vw`} quality={78} loading="eager" draggable="false" />
          </a>
        ))
      }
      <div class="ciel__centre">
        <h1 class="ciel__nom t-titre" data-nom>VALG</h1>
        <p class="ciel__sous t-ital">Photographe &amp; vidéaste — Caen, Normandie</p>
      </div>
      <!-- Le même nom, posé une seconde fois par-dessus les photos. Au défilement, cette copie se dissout :
           on a l'impression que le nom s'enfonce derrière les photos, sans à-coup. -->
      <div class="ciel__centre ciel__centre--devant" aria-hidden="true" data-nom-devant>
        <div class="ciel__nom t-titre" data-nom>VALG</div>
        <p class="ciel__sous t-ital">Photographe &amp; vidéaste — Caen, Normandie</p>
      </div>
    </section>

    <!-- Acte 2 : Valentin se présente. (L'ancien bandeau « À propos » existe toujours : components/v2/BandeauAPropos.astro.) -->
    <Presentation />

    <!-- Acte 4 -->
    <section class="nuage" data-nuage aria-label="Toutes les photos">
      {
        grains.map(({ photo, p, rang }) => (
          <a
            class="nuage__grain"
            href={`/v2/projet/${p.id}/#photo-${rang + 1}`}
            data-vers-projet
            data-cadre
            data-ar={(photo.image.width / photo.image.height).toFixed(3)}
            data-legende={`${p.titre} · ${deuxChiffres(rang + 1)} / ${p.photos.length}`}
            aria-label={`${p.titre}, photo ${rang + 1} sur ${p.photos.length}`}
            tabindex="-1"
          >
            <Image src={photo.image} alt="" widths={[400, 800]} sizes="(max-width: 720px) 70vw, 32vw" quality={78} loading="eager" draggable="false" />
          </a>
        ))
      }
      <div class="nuage__titre">
        <span class="t-ital">({totalPhotos} photos)</span>
        <strong class="t-titre">{projets.length} projets</strong>
      </div>
    </section>

    <!-- Acte 5 -->
    <Anneau />

    <!-- Acte 6 -->
    <section class="refs" id="references" aria-label="Références">
      <div class="refs__txt">
        <p data-lit>Clubs, marques, restaurants, événements : je travaille avec ceux qui ont quelque chose à montrer.</p>
        <p data-lit>Devant mon objectif : SM Caen, Abeille Assurances, Craft, le French Darts Festival, Le Club Porticcio.</p>
      </div>
    </section>

    <!-- Films : un petit écran au milieu de la page, qui s'ouvre jusqu'à remplir la fenêtre pendant que la salle s'éteint -->
    <section class="films" id="films" data-films aria-label="Films">
      <div class="films__noir" aria-hidden="true"></div>
      <!-- Film 1, en largeur : une fenêtre 16/9 qui s'ouvre jusqu'au plein écran -->
      <div class="films__ecran" data-ecran>
        <video class="films__video" data-film data-titre={FILMS[0].titre} src={FILMS[0].src} poster={FILMS[0].affiche} muted playsinline loop preload="metadata"></video>
        <div class="films__voile"></div>
      </div>
      <!-- Film 2, en hauteur : il arrive par la droite et prend le centre -->
      <div class="films__haute">
        <video class="films__video" data-film data-titre={FILMS[1].titre} src={FILMS[1].src} poster={FILMS[1].affiche} muted playsinline loop preload="none"></video>
      </div>
      <p class="films__mot t-titre" data-films-mot aria-hidden="true">Films</p>
      <div class="films__viseur" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
      <div class="films__haut t-mono" aria-hidden="true">
        <span><b class="films__rec"></b>V.A.L.G · films</span>
        <span data-tc>00:00:00:00</span>
      </div>
      <div class="films__bas">
        <div class="films__nom">
          <span class="t-ital" data-film-num>(Film 01)</span>
          <h2 class="films__titre t-titre" data-film-titre>{FILMS[0].titre}</h2>
        </div>
        <div class="films__cote">
          <Compteur valeur={1} total={FILMS.length} data-film-rang />
          <button type="button" class="films__son t-mono" data-son aria-pressed="false">Son coupé</button>
          <button type="button" class="films__son t-mono" data-vue-films="0">Plein écran</button>
        </div>
      </div>
      <p class="films__note t-mono">Deux films, pour commencer.</p>
    </section>

    <!-- Acte 7 -->
    <BandeauContact />

    <Pied />
  </main>
  <Vue />
</V2>
